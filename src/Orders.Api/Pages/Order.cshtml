@page "/Order/{id:guid}"
@model OrderModel
@{
    ViewData["Title"] = Model.Order?.Reference ?? "Order";
}
@if (Model.Order is null)
{
    <h1>Not found</h1>
    <p><a href="/">Back to orders</a></p>
}
else
{
    <p class="crumb"><a href="/">Orders</a> / @Model.Order.Reference</p>
    <h1>@Model.Order.Reference</h1>

    <dl class="meta">
        <dt>Customer</dt><dd class="mono">@(Model.Order.Customer?.Reference) &middot; @(Model.Order.Customer?.FullName)</dd>
        <dt>Placed</dt><dd>@Model.Order.PlacedUtc.UtcDateTime.ToString("dd MMM yyyy HH:mm") UTC (@Model.AgeInDays days ago)</dd>
        <dt>Status</dt><dd><span class="status s-@Model.Order.Status.ToString().ToLowerInvariant()">@Model.Order.Status</span></dd>
        <dt>Total</dt><dd class="num">@Model.Order.TotalAmount.ToString("N2")</dd>
    </dl>

    <table>
        <thead><tr><th>SKU</th><th>Description</th><th class="num">Qty</th><th class="num">Unit</th><th class="num">Line</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Order.Lines)
        {
            <tr>
                <td class="mono">@l.Sku</td>
                <td>@l.Description</td>
                <td class="num">@l.Quantity</td>
                <td class="num">@l.UnitPrice.ToString("N2")</td>
                <td class="num">@((l.Quantity * l.UnitPrice).ToString("N2"))</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="actions">
        <button type="button" disabled title="Not implemented - see tickets/TICKET-101.md">Cancel order</button>
        <span class="hint">Cancellation is not built yet. TICKET-101.</span>
    </div>
}
